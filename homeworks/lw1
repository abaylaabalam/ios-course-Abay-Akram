void main() {
  // TASK 1
  for (int i = 1; i <= 10; i++) {
    for (int j = 1; j <= 10; j++) {
      print('$i * $j = ${i * j}');
    }
    print('---');
  }

  // TASK 2
  int day = 28;
  int month = 2;
  int year = 2024;

  bool leap = false;
  if (year % 400 == 0) {
    leap = true;
  } else if (year % 100 == 0) {
    leap = false;
  } else if (year % 4 == 0) {
    leap = true;
  }

  int daysInMonth = 31;
  if (month == 4 || month == 6 || month == 9 || month == 11) {
    daysInMonth = 30;
  }
  if (month == 2) {
    if (leap) {
      daysInMonth = 29;
    } else {
      daysInMonth = 28;
    }
  }

  if (day > daysInMonth || day < 1 || month > 12 || month < 1) {
    print('invalid date');
  } else {
    day = day + 1;
    if (day > daysInMonth) {
      day = 1;
      month = month + 1;
      if (month > 12) {
        month = 1;
        year = year + 1;
      }
    }
    print('next day: $day.$month.$year');
  }

  // TASK 3
  String text = 'flutter mobile development';
  int vowels = 0;

  for (int i = 0; i < text.length; i++) {
    String letter = text[i];
    if (letter == 'a' ||
        letter == 'e' ||
        letter == 'i' ||
        letter == 'o' ||
        letter == 'u' ||
        letter == 'y') {
      vowels++;
    }
  }
  print('vowels: $vowels');

  // TASK 4
  List<int> numbers = [14, 88, 3, 42, 99, 12, 67];
  int min = numbers[0];
  int max = numbers[0];

  for (int i = 0; i < numbers.length; i++) {
    if (numbers[i] < min) {
      min = numbers[i];
    }
    if (numbers[i] > max) {
      max = numbers[i];
    }
  }
  print('min: $min, max: $max');

  // TASK 5
  int num = 7;
  bool isPrime = true;

  if (num <= 1) {
    isPrime = false;
  }

  for (int i = 2; i < num; i++) {
    if (num % i == 0) {
      isPrime = false;
    }
  }

  if (isPrime) {
    print('$num -> prime number');
  } else {
    print('$num -> not prime number');
  }
}
